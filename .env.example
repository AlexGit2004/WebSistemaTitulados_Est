# ─────────────────────────────────────────────────────────────────
# EJEMPLO de variables de entorno — COPIAR a .env.local y completar
#
#   cp .env.example .env.local     (en Windows: copy .env.example .env.local)
#
# Este archivo NO tiene secretos reales y SÍ se sube al repositorio.
# El archivo .env.local está en .gitignore y NUNCA debe subirse.
# ─────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────
# Development (Windows, PostgreSQL instalado local):
DATABASE_URL=postgresql://postgres:CAMBIAR_ESTA_CLAVE@localhost:5432/sistitulados_db

# Producción on-premise (Linux, PostgreSQL nativo):
#   OJO: nunca uses "localhost" para un nombre de host de BD salvo que
#   la BD esté en la misma máquina. Usá 127.0.0.1 explícito o el host real.
#   Y usá un usuario DEDICADO, no el superusuario "postgres".
# DATABASE_URL=postgresql://seguit_app:CAMBIAR_ESTA_CLAVE@127.0.0.1:5432/sistitulados_db

# Descomentar y usar solo si drizzle-kit no lee .env.local (drizzle.config.ts)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sistitulados_db
# DB_USER=postgres
# DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# ── Aplicación ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# URL pública de la app (usada en metadatos y enlaces)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Secreto de sesión ────────────────────────────────────────────
# Firma los tokens de sesión (HMAC-SHA256, ver src/lib/sesion.ts). Es
# OBLIGATORIO: sin él el login responde 500 y las guardas de /admin y
# /portal rechazan todo. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CAMBIAR_ESTA_CLAVE

# ── Zona horaria ─────────────────────────────────────────────────
# Bolivia no aplica horario de verano; America/La_Paz es UTC-4 todo el año.
TZ=America/La_Paz


# ── Envío de correo (decisión D5: alta pública con verificación) ──────────────
# El enlace de verificación se arma con SITIO_URL. Sin SMTP configurado el correo NO se
# envía: el enlace queda en el log del servidor y la respuesta de /api/registro lo
# devuelve en `enlaceVerificacion`. Configura las cinco variables siguientes para que el
# correo salga de verdad (además hay que instalar la dependencia: pnpm add nodemailer).
SITIO_URL=http://localhost:3000
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=usuario.smtp@umsa.bo
#SMTP_PASS=
#CORREO_REMITENTE=correo.institucional@umsa.bo
